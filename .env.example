# Copy to .env for local use. On Render, set these in Environment (never commit real values).
APP_ENV=development                 # use "production" when deployed (enables Secure cookies + startup checks)
SECRET_KEY=                         # python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=                # python -m app.hashpw
DATABASE_URL=sqlite:///./gillstudio.db   # production: your Neon connection string

BUSINESS_TZ=Asia/Karachi
BUSINESS_TZ_LABEL=Pakistan Standard Time (PKT)

# Email (primary notification channel). resend | smtp | none
EMAIL_PROVIDER=resend
NOTIFY_EMAIL=                       # must be the SAME address you signed up to Resend with (free sandbox rule)
EMAIL_FROM=Gill Studio <onboarding@resend.dev>
RESEND_API_KEY=
# SMTP alternative (blocked on Render's free plan; works on your own PC/other hosts)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Optional tuning
INQUIRY_RATE_LIMIT=5
INQUIRY_RATE_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=900
MIN_FORM_FILL_MS=3000
SESSION_HOURS=8
